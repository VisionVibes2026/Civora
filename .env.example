# ==============================================================================
# Civora Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# Application Runtime Mode: "development" | "production" | "testing"
APP_MODE=development
APP_NAME=Civora
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Server Host & Port
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Connection (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./civora_dev.db

# Vector Database (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=civora_knowledge

# LLM & Embedding Providers ("mock" | "openai" | "google")
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# OCR Provider ("mock" | "paddleocr" | "tesseract")
OCR_PROVIDER=mock

# Speech Providers ("mock" | "indic_asr" | "whisper")
ASR_PROVIDER=mock
TTS_PROVIDER=mock

# Security & Authentication
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
